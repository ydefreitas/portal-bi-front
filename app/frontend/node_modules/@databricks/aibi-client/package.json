{
  "name": "@databricks/aibi-client",
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "CHANGELOG.md"
  ],
  "version": "1.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "databricks-pkgr build",
    "lint:fix": "yarn lint --fix",
    "publish": "yarn build && npm publish --access public",
    "lint": "databricks-lint",
    "prep-deps": ": # magic task to allow yarn ensure-deps plugin prepare dependencies of this package",
    "format:check": "databricks-webfmt --check",
    "format": "databricks-webfmt --write",
    "test": "databricks-jest",
    "type-check": "tsc --noEmit",
    "start:dev": "yarn build && node -r @swc-node/register dev/dev-server/index.ts"
  },
  "dependencies": {
    "@types/ejs": "^3.1.5",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@databricks/config-eslint": "1.0.0",
    "@databricks/config-jest": "1.0.0",
    "@databricks/config-oxlint": "1.0.0",
    "@databricks/config-prettier": "1.0.0",
    "@databricks/db-lint": "1.0.0",
    "@databricks/pkgr": "1.0.0",
    "@databricks/tsconfig": "0.0.0",
    "@jest/globals": "^30.0.2",
    "@swc-node/register": "^1.10.9",
    "@types/express": "^4.17.13",
    "@types/invariant": "^2.2.35",
    "ejs": "^3.1.5",
    "express": "^4.17.1",
    "invariant": "^2.2.4",
    "typescript-7": "typescript@7.0.2"
  }
}